# App
APP_URL=http://localhost:3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/notescript

# Auth (generate long random strings)
AUTH_SECRET=N7vQ2mX9pL4kR8zT6wC3hF5sY1aD
AUTH_COOKIE_NAME=notescript_session

# Optional: skip email verification in local development only
AUTH_SKIP_EMAIL_VERIFICATION=false

# SMTP (optional in development — verification links print to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NoteScript <noreply@localhost>"

# Stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES_FREE=2097152
MAX_UPLOAD_BYTES_STUDENT=10485760
MAX_UPLOAD_BYTES_PRO=26214400

# OCR (tesseract.js downloads language data on first use)
OCR_ENABLED=true
OCR_LANG=eng

# YouTube transcripts use the public timedtext endpoint via youtube-transcript.
# No API key required. Videos without captions cannot be processed.
YOUTUBE_ENABLED=true

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_YOUR_TOKEN_HERE

