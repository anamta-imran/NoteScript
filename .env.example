# App
APP_URL=http://localhost:3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/notescript

# Auth (generate long random strings)
# AUTH_SECRET is server-only. Required in every environment, including Vercel Production.
# Must be at least 32 characters after trim. Never expose this value to the client.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_COOKIE_NAME=notescript_session

# Optional: skip email verification in local development only
AUTH_SKIP_EMAIL_VERIFICATION=true

# SMTP (optional in development — verification links print to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NoteScript <noreply@localhost>"

# Paddle (sandbox for development)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Paddle price IDs
PADDLE_PRICE_STUDENT_MONTHLY=pri_01m2wfdxvt30rdb4esjyez9t41
PADDLE_PRICE_STUDENT_ANNUAL=pri_01m2wfftnb5bhyqphabrh1arew
PADDLE_PRICE_PRO_MONTHLY=pri_01m2wfjt2pbmf61yytvhs2czb9
PADDLE_PRICE_PRO_ANNUAL=pri_01m2wfm5deqy8crseg76z3xhkt

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES_FREE=2097152
MAX_UPLOAD_BYTES_STUDENT=15728640
MAX_UPLOAD_BYTES_PRO=31457280

# OCR (tesseract.js downloads language data on first use)
OCR_ENABLED=true
OCR_LANG=eng

# YouTube transcripts use the public timedtext endpoint via youtube-transcript.
YOUTUBE_ENABLED=true
